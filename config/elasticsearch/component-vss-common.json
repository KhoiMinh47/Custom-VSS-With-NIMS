        "prompt_version": { "type": "keyword" },
        "latency_ms": { "type": "long" },
        "created_at": { "type": "date" },
        "updated_at": { "type": "date" },
        "raw_response_excerpt": { "type": "text", "index": false },
        "feedback_label": { "type": "keyword" },
        "feedback_at": { "type": "date" },
        "feedback_note": { "type": "text" },
        "evidence": { "type": "flattened" },
        "payload": { "type": "flattened" }
