{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ntc:vss:camera-registry:1",
  "title": "Phase 06 camera registry",
  "type": "object",
  "required": ["schema_version", "store", "source_mode", "cameras", "recording", "reconnect"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "store": {
      "type": "object",
      "required": ["store_id", "timezone", "backend_timestamps"],
      "properties": {
        "store_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "timezone": {"type": "string"},
        "backend_timestamps": {"const": "UTC"}
      }
    },
    "source_mode": {"enum": ["simulated_replay", "managed_rtsp", "hybrid_rtsp_replay", "physical_camera_only"]},
    "cameras": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["camera_id", "name", "enabled", "main_stream", "ai_substream"],
        "properties": {
          "camera_id": {"type": "string", "pattern": "^cam-[0-9]{2}$"},
          "main_stream": {"$ref": "#/$defs/stream"},
          "ai_substream": {"$ref": "#/$defs/stream"}
        }
      }
    }
  },
  "$defs": {
    "stream": {
      "type": "object",
      "required": ["uri_secret_ref", "codec", "width", "height", "fps"],
      "properties": {
        "uri_secret_ref": {"type": "string", "pattern": "^camera://"},
        "codec": {"enum": ["h264", "h265"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
