# Copy to config/ui/vss-ui.env locally. Keep the copied file untracked.
# This template contains no credentials, camera URLs or API keys.
PORT=39511
HOST=127.0.0.1
HOSTNAME=127.0.0.1
RUN_APP_NAME=nv-metropolis-bp-vss-ui

NEXT_PUBLIC_APP_TITLE=VSS BLUEPRINT
NEXT_PUBLIC_APP_SUBTITLE=Retail PoC
NEXT_PUBLIC_DARK_THEME_DEFAULT=true
NEXT_PUBLIC_SHOW_THEME_TOGGLE_BUTTON=true

NEXT_PUBLIC_ENABLE_CHAT_TAB=false
NEXT_PUBLIC_ENABLE_CHAT_SIDEBAR=true
NEXT_PUBLIC_CHAT_SIDEBAR_OPEN_DEFAULT=false
NEXT_PUBLIC_WORKFLOW=Retail Vision Agent
NEXT_PUBLIC_HTTP_CHAT_COMPLETION_URL=http://127.0.0.1:39510/compat/chat/stream
NEXT_PUBLIC_WEB_SOCKET_DEFAULT_ON=false
NEXT_PUBLIC_CHAT_HISTORY_DEFAULT_ON=true
NEXT_PUBLIC_ENABLE_INTERMEDIATE_STEPS=false
NEXT_PUBLIC_RIGHT_MENU_OPEN=false
NEXT_PUBLIC_SIDE_CHATBAR_COLLAPSED=true
NEXT_PUBLIC_CHAT_UPLOAD_FILE_ENABLE=false
NEXT_PUBLIC_CHAT_INPUT_MIC_ENABLED=false
NEXT_PUBLIC_INTERACTION_MODAL_CANCEL_ENABLED=false
NEXT_PUBLIC_CHAT_MESSAGE_EDIT_ENABLED=true
NEXT_PUBLIC_CHAT_MESSAGE_SPEAKER_ENABLED=false
NEXT_PUBLIC_CHAT_MESSAGE_COPY_ENABLED=true

NEXT_PUBLIC_SIDEBAR_CHAT_WORKFLOW=Retail Vision Agent
NEXT_PUBLIC_SIDEBAR_CHAT_HTTP_CHAT_COMPLETION_URL=http://127.0.0.1:39510/compat/chat/stream
NEXT_PUBLIC_SIDEBAR_CHAT_WEB_SOCKET_DEFAULT_ON=false
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_HISTORY_DEFAULT_ON=true
NEXT_PUBLIC_SIDEBAR_CHAT_ENABLE_INTERMEDIATE_STEPS=false
NEXT_PUBLIC_SIDEBAR_CHAT_DARK_THEME_DEFAULT=true
NEXT_PUBLIC_SIDEBAR_CHAT_SIDE_CHATBAR_COLLAPSED=true
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_UPLOAD_FILE_ENABLE=false
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_INPUT_MIC_ENABLED=false
NEXT_PUBLIC_SIDEBAR_CHAT_INTERACTION_MODAL_CANCEL_ENABLED=false
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_MESSAGE_EDIT_ENABLED=true
NEXT_PUBLIC_SIDEBAR_CHAT_CHAT_MESSAGE_SPEAKER_ENABLED=false
NEXT_PUBLIC_SIDEBAR_CHAT_SHOW_THEME_TOGGLE_BUTTON=false

NEXT_PUBLIC_ENABLE_ALERTS_TAB=true
# Same-origin Phase 15 gateway adapter for NVIDIA VSS real-time alert rules.
NEXT_PUBLIC_ALERTS_API_URL=http://127.0.0.1:39510/compat/alert-bridge/api/v1
NEXT_PUBLIC_ALERTS_TAB_ALERTS_FETCH_MAX_RESULT_SIZE=100
NEXT_PUBLIC_ALERTS_TAB_ALERTS_FETCH_DEFAULT_TIME_WINDOW_IN_MINUTES=10080
NEXT_PUBLIC_ALERTS_TAB_DEFAULT_AUTO_REFRESH_IN_MILLISECONDS=30000
NEXT_PUBLIC_ALERTS_TAB_VERIFIED_FLAG_DEFAULT=false
NEXT_PUBLIC_ALERTS_TAB_MAX_SEARCH_TIME_LIMIT=0
NEXT_PUBLIC_ALERTS_TAB_MEDIA_WITH_OBJECTS_BBOX=false

NEXT_PUBLIC_ENABLE_SEARCH_TAB=true
NEXT_PUBLIC_SEARCH_TAB_MEDIA_WITH_OBJECTS_BBOX=false
NEXT_PUBLIC_ENABLE_DASHBOARD_TAB=false
NEXT_PUBLIC_ENABLE_MAP_TAB=false
NEXT_PUBLIC_ENABLE_VIDEO_MANAGEMENT_TAB=true
NEXT_PUBLIC_VIDEO_MANAGEMENT_TAB_ADD_RTSP_ENABLE=true
NEXT_PUBLIC_VIDEO_MANAGEMENT_VIDEO_UPLOAD_ENABLE=true

# Same-origin adapters owned by the Phase 15 gateway.
NEXT_PUBLIC_AGENT_API_URL_BASE=http://127.0.0.1:39510/compat/agent/api/v1
NEXT_PUBLIC_VST_API_URL=http://127.0.0.1:39510/compat/vst/api
NEXT_PUBLIC_MDX_WEB_API_URL=http://127.0.0.1:39510/compat/mdx
