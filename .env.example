# Copy only the variables needed by the selected profile into a file below
# .secrets/. Never commit real values.

INFRA_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=vss_control
POSTGRES_USER=vss_app
POSTGRES_PASSWORD=REPLACE_WITH_SECRET
POSTGRES_PORT=5432

REDIS_PASSWORD=REPLACE_WITH_SECRET
REDIS_PORT=6379

MINIO_ROOT_USER=vss_minio_admin
MINIO_ROOT_PASSWORD=REPLACE_WITH_SECRET
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_SECRET
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ELASTICSEARCH_PORT=9200
KAFKA_PORT=9092

LOCAL_UID=1000
LOCAL_GID=1000
ES_JAVA_OPTS=-Xms2g -Xmx2g
PROMETHEUS_RETENTION=15d

# Images are tag-pinned for discovery. Phase scripts record and use digests
# after a successful pull on the target architecture.
POSTGRES_IMAGE=postgres:16-bookworm
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.17.0
KAFKA_IMAGE=apache/kafka:3.9.0
REDIS_IMAGE=redis:7.4-bookworm
MINIO_IMAGE=minio/minio:RELEASE.2024-05-10T01-41-38Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-05-09T17-04-24Z
POSTGRES_EXPORTER_IMAGE=prometheuscommunity/postgres-exporter:v0.16.0
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.67.0
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
GRAFANA_IMAGE=grafana/grafana:11.5.1
CURL_IMAGE=curlimages/curl:8.11.1

# Phase 06 camera files commit only camera:// secret references. Resolved RTSP
# URIs belong in .secrets/camera-uris.json with mode 600.
VIDEO_CAMERA_REGISTRY=config/cameras/cameras.simulated.json
VIDEO_CAMERA_SECRET_FILE=.secrets/camera-uris.json
VIDEO_DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
VIDEO_BACKEND_TIMEZONE=UTC

# NGC_API_KEY is intentionally absent. It must already be loaded into the
# operator-approved shell environment and must never be written here.
